# ---------- App ----------
APP_NAME=MOVIA
APP_URL=http://localhost:3100
APP_PORT=3100
# NODE_ENV lo gestiona Next.js: definirlo aqui rompe la compilacion de produccion.

# ---------- Database ----------
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./movia.db"

# ---------- Auth ----------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
SESSION_COOKIE_NAME=movia_session
SESSION_COOKIE_MAX_AGE=604800

# ---------- Localization ----------
DEFAULT_COUNTRY_CODE=CO
DEFAULT_COUNTRY_NAME=Colombia
DEFAULT_CURRENCY=COP
DEFAULT_CURRENCY_SYMBOL=$
DEFAULT_LOCALE=es-CO
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_PHONE_PREFIX=+57

# ---------- Tax ----------
TAX_RATE=0.19
TAX_LABEL=IVA
TAX_INCLUDED_IN_PRICE=true

# ---------- Publications ----------
PUBLICATION_DURATION_SHORT_DAYS=15
PUBLICATION_DURATION_LONG_DAYS=30
PUBLICATION_EXPIRY_WARNING_DAYS=3
PUBLICATION_MAX_PHOTOS=12
PUBLICATION_MIN_COMPLETENESS=60

# ---------- Bulk upload ----------
BULK_UPLOAD_MAX_ROWS=500
BULK_UPLOAD_MAX_FILE_MB=10

# ---------- Search ----------
SEARCH_PAGE_SIZE=12
SEARCH_MAX_PAGE_SIZE=48

# ---------- Payments ----------
PAYMENT_GATEWAY=wompi
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=COP
PAYMENT_SANDBOX=true

# ---------- WhatsApp ----------
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://wa.me
WHATSAPP_DEFAULT_MESSAGE=Hola, estoy interesado en tu publicacion en MOVIA

# ---------- Company verification ----------
RUES_API_URL=
RUES_API_KEY=
VERIFICATION_AUTO_APPROVE=false

# ---------- Invoicing ----------
INVOICE_PROVIDER=alegra
INVOICE_API_URL=
INVOICE_API_KEY=

# ---------- Storage ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./public/uploads
STORAGE_PUBLIC_URL=/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- PWA ----------
PWA_ENABLED=true

# ---------- UI ----------
UI_BRAND_NAME=MOVIA
UI_BRAND_CLAIM=Lo que tu empresa no usa, muevelo.
UI_ANIMATION_ENABLED=true
UI_ANIMATION_DURATION_FAST=0.15
UI_ANIMATION_DURATION_BASE=0.25
UI_ANIMATION_DURATION_SLOW=0.4
UI_ANIMATION_STAGGER=0.05

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@movia.co
SEED_ADMIN_PASSWORD=Movia2026
SEED_DEMO_PASSWORD=Demo2026
SEED_PUBLICATION_COUNT=24
